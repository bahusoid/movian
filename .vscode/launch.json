{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Android (Attach)",
            "type": "lldb",
            "request": "custom",
            "targetCreateCommands": [
                "target create ${workspaceFolder}/build.android.api21_armv7/libmovian.so",
                "settings set target.exec-search-paths ${workspaceFolder}/build.android.api21_armv7"
            ],
            "processCreateCommands": [
                "gdb-remote 1234"
            ]
        },
        {
            "name": "Debug Movian",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build.linux/movian",
            "args": ["-d", "--debug-glw",  "-p", "plugin_examples/History", "-p", "plugin_examples/HDRezka.TV.MOD",  "-p", "plugin_examples/KinoGo.MOD"],
            // "-p", "plugin_examples/subscriptions"
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Skip SIGPIPE (Broken pipe)",
                    "text": "handle SIGPIPE nostop noprint pass",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build"
        },
        {
            "name": "Debug Movian with ElementSelection",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build.linux/movian",
            "args": ["-d", "--debug-glw", "-p", "plugin_examples/elementselection"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build"
        }
    ]
}