widget(container_z, {
  focusable: select($self.metadata.autofocus, 1.5, 1.0);
  autoRefocusable: select($self.metadata.autofocus, 1.5, 1.0);
  width: $ui.size * 8;


  widget(backdrop, {
    align: bottom;
    source: "skin://graphics/white.png";
    color: 0;
  });

  widget(label, {
    caption: $self.metadata.title;
    sizeScale: 0.75;
  });

});
