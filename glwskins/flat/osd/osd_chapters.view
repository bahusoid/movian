#import "skin://theme.view"


widget(container_y, {
  id: "osd_chapters";

  widget(label, {
    style: "osdsettingtitle";
    height: 3em;
    align: center;
    caption: _("Chapters");
    size: 1.5em;
  });

  RegisterCloseOsdEvents("chapters-btn");

  widget(container_x, {
    widget(list_y, {
      id: "list";

      cloner($core.media.current.chapterindex.positions, container_z, {

        height: 2.5em;
        ListItemHighlight();
        ListItemBevel();

        focusable: select($self.metadata.autofocus, 1.5, 1.0);
        onEvent(activate, {
          $core.media.current.currenttime = $self.timestamp;
        });

        widget(container_x, {
          padding: [0.5em, 0];

          widget(icon, {
            source: "skin://icons/ic_check_48px.svg";
            alpha: iir($core.media.current.currenttime > $self.timestamp &&
                      $core.media.current.currenttime < $self.end, 4);
            style: "NavSelectedText";
          });

          widget(container_y, {
            padding: [0.5em, 0, 0, 0];
            align: center;

            widget(container_x, {
              widget(label, {
                filterConstraintX: true;
                caption: $self.title ?? value2duration($self.timestamp);
                style: "NavSelectedTextSecondary";
              });
            });

            widget(container_x, {
              widget(label, {
                filterConstraintX: true;
                caption: value2duration($self.timestamp);
                style: "NavSelectedTextSecondary";
              });
            });
          });
        });
      });
    });
    widget(slider_y, {
      bind("list");
      width: 4;
      focusable: canScroll();
      alpha: iir(canScroll(), 16);
      widget(quad, {
	alpha: 1;
      });
    });
  });
});
