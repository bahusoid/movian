#import "skin://theme.view"


widget(container_y, {
  id: "osd_chapters";

  widget(label, {
    style: "osdsettingtitle";
    height: 3em;
    align: center;
    caption: _("Chapters");
    size: 1.5em;
  });

  RegisterCloseOsdEvents("chapters-btn");

  widget(container_x, {
    widget(list_y, {
      id: "list";

      cloner($self.media.chapterindex.positions, container_z, {

        height: 3.5em;
        ListItemHighlight();
        ListItemBevel();

        focusable: select($self.metadata.autofocus, 1.5, 1.0);
        onEvent(activate, {
          $core.media.current.currenttime = $self.timestamp;
        });

        widget(container_x, {
          padding: [0.5em, 0];
          spacing: 0.5em;

          widget(container_z, {
            width: 8em;
            widget(image, {
              source: $self.image;
              width: 8em;
              align: center;
            });

            // Background bar
            widget(quad, {
              height: 0.6em;
              width: 8em;
              align: bottom;
              color: 0;
              alpha: 0.4;
              margin: [0, -0.5em, 0, 0];
            });

            // Progress overlay using clipping similar to old skin
            widget(quad, {
              height: 0.6em;
              width: 8em;
              align: bottom;
              color: [0.2,0.6,1];
              alpha: 0.8;
              margin: [0, -0.5em, 0, 0];
              clipping: [-1, 0, 1 - (($core.media.current.currenttime - $self.timestamp) / ($self.end - $self.timestamp)), 0];
            });

          });

          widget(container_y, {
            padding: [0.5em, 0, 0, 0];
            align: center;
            widget(label, {
              filterConstraintX: true;
              caption: $self.title ?? value2duration($self.timestamp);
              style: "NavSelectedTextSecondary";
            });

            widget(label, {
              filterConstraintX: true;
              caption: value2duration($self.timestamp);
              style: "NavSelectedTextSecondary";
            });
          });
        });
      });
    });
    widget(slider_y, {
      bind("list");
      width: 4;
      focusable: canScroll();
      alpha: iir(canScroll(), 16);
      widget(quad, { alpha: 1; });
    });
  });
});
