#import "skin://theme.view"
#import "skin://styles/style_list.view"

#define INFOROW(TITLE, DATA, HIDDEN=false) {
  widget(container_x, {
    hidden: HIDDEN;
    spacing: 1em;

    widget(label, {
      color: 0.7;
      width: 7em;
      align: right;
      caption: TITLE;
    });

    widget(label, {
      caption: DATA;
    });
});
}

#define BUTTON(HIDDEN, ONACT, CAPTION, FOCUSABLE) {
  widget(container_z, {
    hidden: HIDDEN;
    height: 2em;
    GridItemBevel();
    GridItemHighlight();

    focusable: select($self.metadata.autofocus, 1.5, 1.0);
    onEvent(activate, deliverEvent($args, ONACT));

    widget(label, {
      padding: [0.5em, 0];
      caption: CAPTION;
      font: "skin://fonts/RobotoCondensed-Bold.ttf";
    });
  });
}

#define chlog(ver, text) {
  widget(container_x, {
    spacing: 1em;

    widget(label, {
      color: 0.7;
      width: 7em;
      align: right;
      caption: ver;
    });

    widget(label, {
      caption: text;
    });
});

}

widget(container_z, {

  widget(list_y, {
    spacing: 0.3em;
    padding: [$ui.xmargin, 0];

    widget(label, {
      height: 3em;
      align: center;
      size: 1.6em;
      caption: $args.metadata.title;
    });
    widget(container_x, {
      spacing: 1em;

      widget(image, {
        align: top;
        width: 7em;
        source: $args.metadata.icon;
      });

      widget(container_y, {
        filterConstraintX: true;
        spacing: 1em;
        widget(label, {
          caption: $args.metadata.synopsis;
          maxlines: 3;
        });
        widget(label, {
          caption: $args.metadata.description;
          color: 0.7;
          maxlines: 7;
        });
      });
    });


    INFOROW(_("Status:"), $args.status.statustxt);
    INFOROW(_("Author:"), $args.metadata.author);
    INFOROW(_("Installed version:"), $args.status.installedVersion,
            !$args.status.installedVersion);
    INFOROW(_("Available version:"), $args.status.availableVersion,
            !$args.status.availableVersion);
    INFOROW(_("Available version:"), $args.metadata.version,
           !$args.package);

    widget(container_x, {
      padding: [7.5em, 0.1em, 0, 0];
      spacing: 0.3em;

      /* Primary action button: Install / Upgrade */
      BUTTON(!$args.status.canInstall && !$args.status.canUpgrade  && !$args.package,
             select($args.status.canInstall || $args.package, "install:"+($args.package ?? ""),
                    select($args.status.canUpgrade, "upgrade", void)),
             $args.status.installLabel
             );

      /* Secondary action: Uninstall */
      BUTTON(!$args.status.canUninstall,
             "uninstall",
             _("Uninstall")
             );
    });

    /*
      widget(label, {
      caption: _("Changelog");
      style: "ListItemSeparatorLabel";
      });

      chlog("2.0", "Added some new stuff");
      chlog("1.1", "Fix some minor bugs");
      chlog("1.0", "Initial version");
    */

  });
  widget(container_y, {
    align: top;
    widget(container_x, {
      height: 3em;
      BackButton();
    });
  });
});
