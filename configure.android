#!/bin/bash

PLATFORM="android"
DEFAULT_UI="glw"
CONFIGURE_POSTFIX="android"

source support/configure.inc

SDK="${ANDROID_HOME}"

BUILD_TOOLS=36.1.0


show_help(){
  common_help
  echo "  --sdk=PREFIX          Use Android SDK from this path [$SDK]"
  echo "  --ndk=DIR             Use Android NDK from this path [$NDK]"
  echo "  --kind=KIND           Build for specific android configuration"
  echo "                        api21_armv7  ARMv7 SDK version 21 (5.0)"
  echo "                        api21_x86      x86 SDK version 21 (5.0)"
  echo "                        api34_armv8  ARMv8 SDK version 34 (14.0) - recommended"
  exit 1
}

enable sqlite_internal
#enable sqlite_vfs
enable glw_backend_opengl_es
enable glw
enable librtmp
enable httpserver
enable libfreetype
enable stdin
enable polarssl
enable vmir
disable upgrade

[ -f project.config ] && source project.config

for opt do
    optval="${opt#*=}"
    case "$opt" in
        --help)
            show_help
            ;;
        --ndk=*)
            NDK="$optval"
            ;;
        --sdk=*)
            SDK="$optval"
            ;;
        --kind=api21_armv7)
            ANDROID_MIN_SDK_VERSION=21
            ANDROID_TARGET_SDK_VERSION=34
            ANDROID_BUILDKIND_DESCRIMINATOR=1
            ANDROID_ABI=armeabi-v7a
            BUILD=android.api${ANDROID_MIN_SDK_VERSION}_armv7
            ANDROID_KIND=armv7
            ARCH_CFLAGS="-march=armv7-a -mfloat-abi=softfp -mfpu=neon -funwind-tables -fPIC"
            ARCH_LDFLAGS="-march=armv7-a"
            LIBAV_ARCH_FLAGS="--enable-cross-compile --arch=armv7 --target-os=android --disable-shared --enable-static"
            ;;
        --kind=api21_x86)
            ANDROID_MIN_SDK_VERSION=21
            ANDROID_TARGET_SDK_VERSION=34
            ANDROID_ABI=x86
            ANDROID_BUILDKIND_DESCRIMINATOR=2
            BUILD=android.api${ANDROID_MIN_SDK_VERSION}_x86
            ANDROID_KIND=x86
            ARCH_CFLAGS="-fPIC"
            LIBAV_ARCH_FLAGS="--enable-cross-compile --arch=x86 --target-os=android --disable-shared --enable-static --disable-asm --disable-inline-asm"
            ;;
        --kind=api34_armv8)
            ANDROID_MIN_SDK_VERSION=21
            ANDROID_TARGET_SDK_VERSION=34
            ANDROID_BUILDKIND_DESCRIMINATOR=3
            ANDROID_ABI=arm64-v8a
            BUILD=android.api${ANDROID_MIN_SDK_VERSION}_armv8
            ANDROID_KIND=armv8
            ARCH_CFLAGS="-march=armv8-a -fPIC"
            ARCH_LDFLAGS=""
            LIBAV_ARCH_FLAGS="--enable-cross-compile --arch=aarch64 --target-os=android --disable-shared --enable-static"
            ;;
        *)
            common_opt $opt $optval
    esac
done

if [ -z "${ANDROID_BUILDKIND_DESCRIMINATOR}" ]; then
    echo "Android build kind not set (--kind option)"
    echo "See ./configure.android --help"
    die
fi

if [ -z "${SDK}" ]; then
    echo "Android SDK not set"
    echo "Either specify path to SDK using --sdk=/path/to/sdk"
    echo " OR "
    echo "Set ANDROID_HOME environment variable"
    die
fi

echo "Using Android SDK at : ${SDK}"
echo

if [ -z "${NDK}" ]; then
    NDK=${SDK}/ndk-bundle
fi

# Set up toolchain after NDK is determined
TOOLCHAIN=${NDK}/toolchains/llvm/prebuilt/linux-x86_64/bin/

case "${ANDROID_KIND}" in
    armv7)
        CC=${TOOLCHAIN}armv7a-linux-androideabi21-clang
        CXX=${TOOLCHAIN}armv7a-linux-androideabi21-clang++
        ;;
    x86)
        CC="${TOOLCHAIN}i686-linux-android21-clang -mstackrealign"
        CXX="${TOOLCHAIN}i686-linux-android21-clang++ -mstackrealign"
        ;;
    armv8)
        CC=${TOOLCHAIN}aarch64-linux-android34-clang
        CXX=${TOOLCHAIN}aarch64-linux-android34-clang++
        ;;
esac

setup_env "$@"

echo "Using Android NDK at : ${NDK}"
stat "${NDK}"
echo

if [ ! -f "${CC}" ]; then
    echo "Verifying NDK toolchain..."
    stat "${NDK}/toolchains/llvm/prebuilt/linux-x86_64/bin/"
    if [ ! -d "${NDK}/toolchains/llvm/prebuilt/linux-x86_64/bin/" ]; then
        echo "NDK toolchain not found, either set NDK environment variable or specify --ndk=/path/to/ndk"
        echo "Modern NDK (r21+) required with llvm/prebuilt toolchain"
        die
    fi
fi


# Modern NDK uses llvm- prefix for binutils tools
LLVM_TOOLCHAIN="${TOOLCHAIN}llvm-"
TOOLCHAIN="${LLVM_TOOLCHAIN}"

# Set cross-compilation tools for FFmpeg
LIBAV_ARCH_FLAGS="${LIBAV_ARCH_FLAGS} --cross-prefix=${LLVM_TOOLCHAIN}"

bzip2_setup
freetype_setup --host=arm-linux-gnueabihf

LIBAV_CFLAGS="-I${EXT_INSTALL_DIR}/include ${ARCH_CFLAGS}"
LIBAV_LDFLAGS="-L${EXT_INSTALL_DIR}/lib  ${ARCH_LDFLAGS}"

ext_setup
libyuv_setup

cat >> ${CONFIG_MAK} <<EOF
CFLAGS_arch = ${ARCH_CFLAGS}
CFLAGS_cfg += ${ARCH_CFLAGS}
LDFLAGS_cfg += ${ARCH_LDFLAGS} -lOpenSLES -lGLESv2 -llog -landroid -ljnigraphics -lmediandk
ANDROID_BUILD_TOOLS := ${SDK}/build-tools/${BUILD_TOOLS}
ANDROID_PLATFORM_PATH := ${SDK}/platforms/android-${ANDROID_TARGET_SDK_VERSION}
ANDROID_BUILDKIND_DESCRIMINATOR := ${ANDROID_BUILDKIND_DESCRIMINATOR}
ANDROID_MIN_SDK_VERSION := ${ANDROID_MIN_SDK_VERSION}
ANDROID_TARGET_SDK_VERSION := ${ANDROID_TARGET_SDK_VERSION}
ANDROID_ABI := ${ANDROID_ABI}
TOOLCHAIN := ${TOOLCHAIN}
EOF

finalize
